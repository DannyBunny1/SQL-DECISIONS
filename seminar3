
#Exercise 1
SELECT CASE WHEN (SELECT COUNT(DISTINCT salary) FROM Employee) > 1 AND 
(SELECT COUNT(*) FROM Employee) != 0
THEN (SELECT salary FROM Employee GROUP BY salary ORDER BY salary DESC OFFSET 1 LIMIT 1)
ELSE NULL
END AS "SecondHighestSalary"
FROM (SELECT * FROM Employee UNION SELECT NULL AS "id", NULL AS "salary")
LIMIT 1;

#Exercise 2
SELECT oct.department AS "Department", Employee.name AS "Employee", oct.maxi AS "Salary" FROM Employee
JOIN
(SELECT d.name AS "department", max(e.salary) AS "maxi", max(d.id) AS "id"
FROM Employee e JOIN Department d ON e.departmentId = d.id
GROUP BY d.name) oct
ON Employee.departmentId = oct.id AND Employee.salary = oct.maxi;


